#!/bin/sh
# bh - one command line for this repository. Run "./bh" to see what it can do.
# (Windows: use bh.cmd, or run this file inside WSL.)

dir=$(cd "$(dirname "$0")" && pwd)

for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$py" "$dir/Util/bh/bh.py" "$@"
  fi
done
if command -v py >/dev/null 2>&1; then
  exec py -3 "$dir/Util/bh/bh.py" "$@"
fi
echo "bh needs Python 3.9 or newer, but no suitable python3 was found." >&2
exit 1
